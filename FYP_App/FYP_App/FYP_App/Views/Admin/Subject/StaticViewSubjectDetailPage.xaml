<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.Subject.StaticViewSubjectDetailPage">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>
            <Label Text="View Subject" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30"/>

            <ScrollView>
                <Grid VerticalOptions="Start" RowSpacing="10" ColumnDefinitions="*, 2*" Margin="20" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                    <Label Text="Subject code: " TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                    <Label x:Name="subjectLabel" TextColor="Black" FontSize="18" Grid.Column="1"/>

                    <Label Text="Subject name:" TextColor="Black" FontSize="18" Grid.Row="1"/>
                    <Label x:Name="subjectNameLabel" TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="1" Grid.Column="1"/>

                    <Label Text="Faculty: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="2"/>
                    <Label x:Name="facultyLabel" TextColor="Black" FontSize="18" Grid.Row="2" Grid.Column="1"/>

                    <Label Text="Course: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="3"/>
                    <Label x:Name="courseLabel" TextColor="Black" FontSize="18" Grid.Row="3" Grid.Column="1"/>

                    <Label Text="Year of Student: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="4"/>
                    <Label x:Name="studentYearLabel" TextColor="Black" FontSize="18" Grid.Row="4" Grid.Column="1"/>

                    <Label Text="Active Semester: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="5"/>
                    <Label x:Name="activeSemesterLabel" TextColor="Black" FontSize="18" Grid.Row="5" Grid.Column="1"/>

                    <Label Text="Class: " Grid.Row="6" TextColor="Black" FontSize="18"/>
                    <ListView x:Name="classListView" IsEnabled="False" Grid.Row="6" Grid.Column="1" HeightRequest="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <StackLayout Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected}"/>
                                        <Label Text="{Binding ClassName}" TextColor="Black" FontSize="18" VerticalTextAlignment="Center"/>
                                    </StackLayout>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Label Text="Lecturer Option: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="7"/>
                    <Frame Grid.Row="7" Grid.Column="1" Padding="10" HasShadow="False">
                        <StackLayout Orientation="Horizontal" IsEnabled="False">
                            <RadioButton x:Name="singleLecturerRB" Content="Single" GroupName="lecturerOption" />
                            <RadioButton x:Name="multipleLecturerRB" Content="Multiple" GroupName="lecturerOption"/>
                        </StackLayout>
                    </Frame>

                    <Frame x:Name="singleLecturer" Padding="0" Grid.Row="8" Grid.ColumnSpan="2" HasShadow="False">
                        <Grid ColumnDefinitions="*, 1.5*">
                            <Label Text="Lecturer Name: " TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="lecturerNameLabel" TextColor="Black" FontSize="18" Grid.Column="1"/>

                            <Label Text="Class: " Grid.Row="1" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="singleLecturerClassLabel" Grid.Row="1" Grid.Column="1" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                            <Label Text="Session: Both Lecture and Lab" Grid.Row="2" Grid.ColumnSpan="2" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                    <Frame x:Name="multipleLecturer" Padding="0" Grid.Row="8" Grid.ColumnSpan="2" HasShadow="False">
                        <Grid ColumnDefinitions="*, 1.5*" RowDefinitions="Auto, Auto, Auto, Auto">
                            <Label Text="Lecturer number: " TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="lecturerNumberLabel" TextColor="Black" FontSize="18" Grid.Column="1" VerticalTextAlignment="Center"/>

                            <Grid x:Name="lecturerNumberPickerGrid" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*, 1.5*, 0.5*" RowDefinitions="Auto, Auto, Auto">
                                <Label Text="Lecturer 1: " TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                                <Label x:Name="lecturerNameLabel1" TextColor="Black" FontSize="18" Grid.Column="1"/>

                                <Label Text="Lecturer 2:" Grid.Row="1" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                                <Label x:Name="lecturerNameLabel2" TextColor="Black" FontSize="18" Grid.Row="1" Grid.Column="1"/>

                                <Label x:Name="labelLecturerNameEntry3" Text="Lecturer 3:" Grid.Row="2" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                                <Label x:Name="lecturerNameLabel3" IsEnabled="False" TextColor="Black" FontSize="18" Grid.Row="2" Grid.Column="1"/>
                            </Grid>

                            <Frame Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="White" BorderColor="Black">
                                <Label Text="Class and Session Assignment" TextColor="Black" FontSize="18" VerticalTextAlignment="Center"/>
                            </Frame>
                            <ListView Grid.Row="3" Grid.ColumnSpan="2" x:Name="classSessionAssignmentListView" HasUnevenRows="True" HeightRequest="200">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Frame BackgroundColor="White" BorderColor="Black" Padding="15">
                                                <Grid ColumnDefinitions="*, 2*" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                                                    <Label Text="{Binding ClassName}" TextColor="Black" FontSize="18"/>

                                                    <Label Text="Lecturer:" TextColor="Black" FontSize="18" Grid.Row="1"/>
                                                    <Label Text="{Binding LecturerName1}" TextColor="Black" FontSize="18" Grid.Row="1" Grid.Column="1"/>

                                                    <Label Text="Session:" TextColor="Black" FontSize="18" Grid.Row="2"/>
                                                    <StackLayout Orientation="Horizontal" IsEnabled="False" Grid.Row="3" Grid.ColumnSpan="2">
                                                        <RadioButton Content="Both" IsChecked="{Binding isCheckedBoth}" GroupName="sessionOption"/>
                                                        <RadioButton Content="Lecture" IsChecked="{Binding isCheckedLecture}" GroupName="sessionOption" />
                                                        <RadioButton Content="Lab" IsChecked="{Binding isCheckedLab}" GroupName="sessionOption"/>
                                                    </StackLayout>

                                                    <StackLayout Margin="0, 10" IsVisible="{Binding isVisiblelayoutSession2}" Grid.Row="4" Grid.ColumnSpan="2">
                                                        <Grid ColumnDefinitions="*, 2*">
                                                            <Label Text="Lecturer:" TextColor="Black" FontSize="18"/>
                                                            <Label Text="{Binding LecturerName2}" TextColor="Black" FontSize="18" Grid.Column="1"/>

                                                            <Label Text="Session:" TextColor="Black" FontSize="18" Grid.Row="1"/>
                                                            <StackLayout Orientation="Horizontal" IsEnabled="False" Grid.Row="2">
                                                                <RadioButton Content="Both" IsChecked="false" GroupName="sessionOption2"/>
                                                                <RadioButton Content="Lecture" IsChecked="{Binding isCheckedLecture2}" GroupName="sessionOption2"/>
                                                                <RadioButton Content="Lab" IsChecked="{Binding isCheckedLab2}" GroupName="sessionOption2"/>
                                                            </StackLayout>
                                                        </Grid>
                                                    </StackLayout>
                                                </Grid>
                                            </Frame>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Frame>

                    <Grid ColumnDefinitions="*, *" Grid.Row="9" Grid.ColumnSpan="2" Margin="0, 10, 0, 30">
                        <Frame BackgroundColor="#7192F1" Padding="10">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapEditSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                            </Frame.GestureRecognizers>
                            <Label Text="Edit Subject" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Frame>
                        <Frame BackgroundColor="#FF0E00" Padding="10" Grid.Column="1">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapDeleteSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                            </Frame.GestureRecognizers>
                            <Label Text="Delete Subject" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Frame>
                    </Grid>
                </Grid>
            </ScrollView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>