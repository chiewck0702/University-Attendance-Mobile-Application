<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.ManageSubjectPage">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <Label Text="Manage Subject" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30"/>

            <Grid ColumnDefinitions="*, 5*, *, *, *" Margin="20" RowDefinitions="40">
                <Image x:Name="searchIcon" HeightRequest="40" WidthRequest="40"/>
                <Entry x:Name="searchEntry" Completed="searchEntry_Completed" Placeholder="Subject Name / Code" Grid.Column="1"/>
                <Image x:Name="addIcon" Grid.Column="2">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapAddSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="editIcon" Grid.Column="3">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapEditSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
                <Image x:Name="deleteIcon" Grid.Column="4">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapDeleteSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <ScrollView Orientation="Horizontal">
                <StackLayout>
                    <Frame BackgroundColor="LightGray" Margin="20, 0">
                        <Grid ColumnDefinitions="0.5*, 1.6*, *, *, *" RowDefinitions="Auto" >
                            <Label Text="Subject Name" FontAttributes="Bold" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="1"/>
                            <Label Text="Subject ID" FontAttributes="Bold" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="2"/>
                            <Label Text="Lecturer" FontAttributes="Bold" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="3"/>
                            <Label Text="Active Semester" FontAttributes="Bold" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="4"/>
                        </Grid>
                    </Frame>
                    <ListView x:Name="subjectList" HasUnevenRows="True" Margin="20, 0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid ColumnDefinitions="0.5*, 1.6*, *, *, *" RowDefinitions="Auto" Margin="0, 10">
                                        <CheckBox x:Name="subjectCheckbox" IsChecked="{Binding isSelected}" CheckedChanged="subjectCheckbox_CheckedChanged"/>
                                        <Label Text="{Binding SubjectName}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="1">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapViewSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding SubjectId}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="2">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapViewSubjectGestureRecognizer_Tapped" NumberOfTapsRequired="1"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding LecturerName}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="3"/>
                                        <Label Text="{Binding ActiveSemester}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="4"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackLayout>
            </ScrollView>            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>