<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.UploadStudentListPage">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <Label Text="Upload Student List" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30, 30, 30, 20"/>

            <Frame Margin="20, 20, 20, 0">
                <Label Text="My Subject" FontAttributes="Bold" TextColor="Black" FontSize="18"/>
            </Frame>
            <Frame Margin="20, 0">
                <ListView x:Name="subjectListview" SeparatorVisibility="None" HasUnevenRows="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Grid ColumnDefinitions="1.5*, *" RowDefinitions="Auto, Auto">
                                    <Label Text="{Binding SubjectId}" FontAttributes="Bold" TextColor="Black" FontSize="18"/>
                                    <Label Text="{Binding SubjectName}" LineBreakMode="WordWrap" Grid.Row="1" FontSize="18"/>
                                    <StackLayout Orientation="Horizontal" VerticalOptions="Center" Grid.RowSpan="2" Grid.Column="1">
                                        <Frame BackgroundColor="Black" CornerRadius="10" Padding="5">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapUploadStudentList_Tapped" NumberOfTapsRequired="1"/>
                                            </Frame.GestureRecognizers>
                                            <Label Margin="0, 5" Text="Upload Student List" FontSize="14" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" TextColor="White"/>
                                        </Frame>
                                        <Image Source="{Binding ImageIcon}" WidthRequest="15" HeightRequest="10"/>
                                    </StackLayout>
                                </Grid>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Frame>            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>