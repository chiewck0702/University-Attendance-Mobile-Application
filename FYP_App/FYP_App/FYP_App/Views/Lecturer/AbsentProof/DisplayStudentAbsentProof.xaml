<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.Lecturer.AbsentProof.DisplayStudentAbsentProof">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <Label Text="Upload Student Absent Proof" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30, 30, 30, 20"/>

            <ScrollView>
                <Grid VerticalOptions="Start" ColumnDefinitions="*, 1.5*" Margin="20" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                    <Label Text="Subject code: " TextColor="Black" FontSize="20" VerticalOptions="Center"/>
                    <Label x:Name="subjectLabel" TextColor="Black" FontSize="20" Grid.Column="1"></Label>

                    <Label Text="Subject name:" TextColor="Black" FontSize="20" Grid.Row="1"/>
                    <Label x:Name="subjectName" TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="1" Grid.Column="1"/>

                    <Label Text="Session: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="2"/>
                    <Label x:Name="sessionLabel" TextColor="Black" FontSize="20" Grid.Row="2" Grid.Column="1"/>

                    <Label Text="Week: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="3"/>
                    <Label x:Name="weekLabel" TextColor="Black" FontSize="20" Grid.Row="3" Grid.Column="1"/>

                    <Label Text="Date: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="4"/>
                    <Label x:Name="dateLabel" TextColor="Black" FontSize="20" Grid.Row="4" Grid.Column="1"/>

                    <Label Text="Student Name: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="5"/>
                    <Label x:Name="studentNameLabel" TextColor="Black" FontSize="20" Grid.Row="5" Grid.Column="1"/>

                    <Label Text="Student ID: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="6"/>
                    <Label x:Name="studentIdLabel" TextColor="Black" FontSize="20" Grid.Row="6" Grid.Column="1"/>

                    <Label Text="Reason: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="7"/>
                    <Entry x:Name="reasonEntry" Grid.Row="7" Grid.Column="1"/>

                    <Label Text="File Name: " TextColor="Black" FontSize="20" VerticalOptions="Center" Grid.Row="8"/>
                    <Label x:Name="fileNameLabel" TextColor="Black" FontSize="20" Grid.Row="8" Grid.Column="1"/>

                    <Frame Grid.Row="9" Grid.ColumnSpan="2" BackgroundColor="#7192F1" Padding="10" Margin="0, 10, 0, 30">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapChooseAnotherFile_Tapped" NumberOfTapsRequired="1"/>
                        </Frame.GestureRecognizers>
                        <Label Text="Choose Another File" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Frame>

                    <Frame Grid.Row="11" Grid.ColumnSpan="2" BackgroundColor="#37D13F" Padding="10" Margin="0, 10, 0, 30">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapConfirm_Tapped" NumberOfTapsRequired="1"/>
                        </Frame.GestureRecognizers>
                        <Label Text="Confirm" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Frame>
                </Grid>
            </ScrollView>            

        </StackLayout>
    </ContentPage.Content>
</ContentPage>