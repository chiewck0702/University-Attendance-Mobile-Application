<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.UploadStudentLeaveProofPage">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>

            <Label Text="Upload Student Absent Proof" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30"/>

            <Grid>
                <ScrollView Margin="20" x:Name="contentScrollview" Scrolled="ScrollView_Scrolled">
                    <StackLayout>
                        <Grid VerticalOptions="Start" ColumnDefinitions="*, 1.5*" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <Label Text="Subject code: " TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                            <Picker x:Name="subjectPicker" Title="Select an option" SelectedIndexChanged="subjectPicker_SelectedIndexChanged" Grid.Column="1"></Picker>

                            <Label Text="Subject name:" TextColor="Black" FontSize="18" Grid.Row="1"/>
                            <Label x:Name="subjectName" TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="1" Grid.Column="1"/>

                            <Label Text="Session: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="2"/>
                            <Picker x:Name="sessionPicker" IsEnabled="False" Title="Select an option" SelectedIndexChanged="sessionPicker_SelectedIndexChanged" Grid.Row="2" Grid.Column="1"/>

                            <Label Text="Week: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="3"/>
                            <Picker x:Name="weekPicker" IsEnabled="False" Title="Select an option" SelectedIndexChanged="weekPicker_SelectedIndexChanged" Grid.Row="3" Grid.Column="1"/>

                            <Label Text="Date: " TextColor="Black" FontSize="18" VerticalOptions="Center" Grid.Row="4"/>
                            <Picker x:Name="datePicker" IsEnabled="False" Title="Select an option" SelectedIndexChanged="datePicker_SelectedIndexChanged" Grid.Row="4" Grid.Column="1"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, 3*, *" HeightRequest="50">
                            <Image x:Name="searchIcon" HeightRequest="50" WidthRequest="50"/>
                            <Entry x:Name="searchEntry" Placeholder="Student Name / ID" Completed="searchEntry_Completed" Grid.Column="1"/>
                        </Grid>

                        <Frame BackgroundColor="LightGray" Padding="5">
                            <Grid ColumnDefinitions="*, *, 0.5*, 0.5*" RowDefinitions="Auto" Margin="0, 10">
                                <Label Text="Name" FontAttributes="Bold" TextColor="Black" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                <Label Text="Student ID" FontAttributes="Bold" TextColor="Black" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="1"/>
                                <Label Text="Class" FontAttributes="Bold" TextColor="Black" FontSize="16" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="2"/>
                            </Grid>
                        </Frame>

                        <ListView x:Name="nameList" HasUnevenRows="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid ColumnDefinitions="*, *, 0.5*, 0.5*" RowDefinitions="Auto" Margin="10">
                                            <Label Text="{Binding StudentName}" TextColor="Black" FontSize="18" VerticalOptions="Center"/>
                                            <Label Text="{Binding StudentId}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="1"/>
                                            <Label Text="{Binding ClassName}" TextColor="Black" FontSize="18" HorizontalTextAlignment="Center" VerticalOptions="Center" Grid.Column="2"/>
                                            <Frame BackgroundColor="Black" CornerRadius="10" Padding="5" VerticalOptions="Center" Grid.Column="3">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapUploadStudentList_Tapped" NumberOfTapsRequired="1"/>
                                                </Frame.GestureRecognizers>
                                                <Label Margin="0, 5" Text="Upload Leave Proof" FontSize="16" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" TextColor="White"/>
                                            </Frame>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackLayout>
                </ScrollView>

                <Image Margin="20" VerticalOptions="End" HorizontalOptions="End" x:Name="arrowUpIcon" IsVisible="False" WidthRequest="50" HeightRequest="50">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapArrowUp_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>