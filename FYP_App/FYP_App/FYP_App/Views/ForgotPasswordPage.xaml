<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FYP_App.Views.ForgotPasswordPage">
    <ContentPage.Content>
        <StackLayout BackgroundColor="White">
            <Frame BackgroundColor="#2196F3" HeightRequest="50" Padding="5">
                <Image x:Name="backIcon" Margin="10, 0" VerticalOptions="Center" HorizontalOptions="Start" HeightRequest="25" WidthRequest="25">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapBackButton_Tapped" NumberOfTapsRequired="1"/>
                    </Image.GestureRecognizers>
                </Image>
            </Frame>
            
            <Label Text="Forgot Password" TextColor="Black" FontAttributes="Bold" FontSize="25" HorizontalOptions="Center" Margin="30"/>

            <ScrollView>
                <Grid VerticalOptions="Start" Margin="20" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                    <Label Text="Email address:" TextColor="Black" FontSize="20"/>

                    <Entry x:Name="emailEntry" Grid.Row="1"/>

                    <Frame Grid.Row="2" x:Name="sendEmailButton" BackgroundColor="#7192F1" Padding="10" Margin="0, 10, 0, 30">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapSendEmail_Tapped" NumberOfTapsRequired="1"/>
                        </Frame.GestureRecognizers>
                        <Label x:Name="buttonLabel" Text="Click to send verification email" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                    </Frame>

                    <ActivityIndicator Grid.Row="3"
        x:Name="loadingIndicator"
        IsVisible="False"
        IsRunning="False"
        HorizontalOptions="Center"
        VerticalOptions="Center" />

                    <StackLayout x:Name="verificationCodeLayout" IsVisible="false" Grid.Row="3">
                        <Grid RowDefinitions="Auto, Auto, Auto">
                            <Label Text="Verification code:" TextColor="Black" FontSize="20"/>

                            <Entry x:Name="codeEntry" Grid.Row="1"/>

                            <Frame Grid.Row="2" x:Name="verifyCodeButton" BackgroundColor="#7192F1" Padding="10" Margin="0, 10, 0, 30">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapVerifyCode_Tapped" NumberOfTapsRequired="1"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Verify" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Frame>
                        </Grid>
                    </StackLayout>

                    <StackLayout x:Name="newPasswordLayout" IsVisible="false" Grid.Row="4">
                        <Grid ColumnDefinitions="*, 50" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <StackLayout Orientation="Horizontal">
                                <Label Text="New Password:" Grid.ColumnSpan="2" TextColor="Black" FontSize="20"/>
                                <Image x:Name="infoIcon" WidthRequest="50" HeightRequest="50">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapInfoButton_Tapped" NumberOfTapsRequired="1"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </StackLayout>

                            <Entry x:Name="newPasswordEntry" IsPassword="True" Grid.Row="1"/>
                            <Frame BackgroundColor="White" Grid.Row="1" Grid.Column="1" Padding="0" VerticalOptions="Center">
                                <Image x:Name="newPasswordVisibility" WidthRequest="30" HeightRequest="30">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapNewPasswordVisibility_Tapped" NumberOfTapsRequired="1">
                                        </TapGestureRecognizer>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Frame>

                            <Label Text="Confirm Password:" Grid.ColumnSpan="2" TextColor="Black" FontSize="20" Grid.Row="2"/>

                            <Entry x:Name="confirmPasswordEntry" IsPassword="True" Grid.Row="3"/>
                            <Frame BackgroundColor="White" Grid.Row="3" Grid.Column="1" Padding="0" VerticalOptions="Center">
                                <Image x:Name="confirmPasswordVisibility" WidthRequest="30" HeightRequest="30">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="TapConfirmPasswordVisibility_Tapped" NumberOfTapsRequired="1">
                                        </TapGestureRecognizer>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Frame>

                            <Frame Grid.Row="4" Grid.ColumnSpan="2" BackgroundColor="#37D13F" Padding="10" Margin="0, 10, 0, 30">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapConfirm_Tapped" NumberOfTapsRequired="1"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Confirm" TextColor="White" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Frame>
                        </Grid>
                    </StackLayout>
                </Grid>
            </ScrollView>
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>